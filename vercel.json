{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py?__api=$1" },
    { "source": "/assets/(.*)", "destination": "/api/main.py?__asset=$1" },
    { "source": "/(.*)", "destination": "/api/main.py?__path=$1" }
  ]
}
