# Startify — XAUUSD Multi-AI Paper Trader Environment Variables
# Copy this file to .env and fill in the keys you wish to activate.
# Agents without an API key automatically run in deterministic strategy simulation mode.

# 1. Free AI Provider Keys (No Credit Card Required)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ZAI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=

# 2. Market Data & USD Macro News Keys (Optional — falls back to public feeds / seeded historical)
TWELVEDATA_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
FRED_API_KEY=
FINNHUB_API_KEY=

# 3. Discord Multi-Channel Webhooks (One per AI channel + Consensus + Weekly + System Log)
DISCORD_WEBHOOK_AI1=
DISCORD_WEBHOOK_AI2=
DISCORD_WEBHOOK_AI3=
DISCORD_WEBHOOK_AI4=
DISCORD_WEBHOOK_AI5=
DISCORD_WEBHOOK_AI6=
DISCORD_WEBHOOK_AI7=
DISCORD_WEBHOOK_AI8=
DISCORD_WEBHOOK_CONSENSUS=
DISCORD_WEBHOOK_WEEKLY_REPORT=
DISCORD_WEBHOOK_SYSTEM_LOG=

# 4. Database / Cloud Persistence (SQLite by default; optional Supabase / Postgres URL for Vercel)
DATABASE_PATH=db/trades.sqlite
SUPABASE_URL=
SUPABASE_ANON_KEY=
