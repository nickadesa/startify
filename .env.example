# Startify — Autonomous XAUUSD Multi-AI Arena (.env)
# ก๊อปปี้ไปวางในหน้า Environment Variables ของ Hostless Cloud (หรือบันทึกเป็น .env)
# โมเดลไหนที่ไม่ได้ใส่ API Key จะวิ่งโหมด rules อัตโนมัติ

# --- 1. Core, Database (Turso) & Security ---
PYTHON_VERSION=3.11.9
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIVE_DB_PATH=/data/live.sqlite
ADMIN_TOKEN=change-me-to-your-secret-token

# --- 2. Discord Webhooks (ส่งผลเทรด + ห้องแชท AI) ---
DISCORD_WEBHOOK_LIVE_TRADES=
DISCORD_WEBHOOK_GROKBOT=

# --- 3. AI Model API Keys (8 Models) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
